{
  "name": "setvalue",
  "version": "0.1.0",
  "private": true,
  "description": "SetValue — the Pokemon collector operating system",
  "scripts": {
    "dev": "next dev -p 3000",
    "build": "next build",
    "start": "next start -p 3000",
    "lint": "next lint",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "ingest:catalog": "tsx scripts/pg/ingest.ts catalog",
    "ingest:prices": "tsx scripts/pg/ingest.ts prices",
    "seed:demo": "tsx scripts/seed-demo.ts",
    "setup": "node scripts/fetch-catalog.mjs && node scripts/fetch-prices.mjs && npm run migrate && npm run ingest:catalog && npm run ingest:prices",
    "snapshot:prices": "./scripts/snapshot-prices.sh",
    "test:e2e": "node tests/e2e/flow.mjs",
    "migrate": "node scripts/pg/migrate.mjs",
    "load:generate": "tsx tests/load/generate.ts"
  },
  "dependencies": {
    "@supabase/ssr": "^0.12.4",
    "@supabase/supabase-js": "^2.112.3",
    "next": "^15.5.23",
    "pg": "^8.23.0",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@types/node": "^26.2.0",
    "@types/pg": "^8.23.1",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.4",
    "autoprefixer": "^10.5.4",
    "playwright": "^1.62.1",
    "postcss": "^8.5.26",
    "tailwindcss": "^3.4.19",
    "tsx": "^4.23.12",
    "typescript": "^5.9.3",
    "vitest": "^4.1.10"
  }
}
