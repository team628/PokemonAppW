# SetValue — environment. Copy to `.env.local` for development.
#
# NOTHING IN THIS FILE IS A SECRET. It is the shape of the configuration, with
# every value replaced by a description of it. Real values belong in the Vercel
# project's Environment Variables and in the Supabase dashboard — never in the
# repository, and never in a file git can see.

# ---------------------------------------------------------------- identity ---
# From Supabase → Project Settings → API. Both are public by design: the anon
# key is a JWT that grants only what Row Level Security allows it.
NEXT_PUBLIC_SUPABASE_URL=https://<project-ref>.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=<anon public key>

# SERVER ONLY. Bypasses Row Level Security entirely. Never prefix it with
# NEXT_PUBLIC_, never reference it from a client component, and scope it to the
# server in Vercel. Used by background jobs and the billing webhook only.
SUPABASE_SERVICE_ROLE_KEY=<service role key>

# ---------------------------------------------------------------- database ---
# SERVER ONLY. Supabase → Project Settings → Database → Connection string →
# "Transaction pooler". It must be the Supavisor pooler on port 6543: a
# serverless function opening a direct 5432 connection per invocation exhausts
# the database's connection slots under any real traffic.
SUPABASE_DB_URL=postgresql://postgres.<ref>:<password>@aws-0-<region>.pooler.supabase.com:6543/postgres

# Per-instance pool size. The default of 8 suits a transaction-mode pooler; a
# dashboard request opens three concurrent connections, so this is the ceiling
# on concurrent page renders per serverless instance.
# PG_POOL_MAX=8

# ---------------------------------------------------------------- provider ---
CARD_DATA_PROVIDER=pokemontcg
# Optional. Raises the provider's rate limit; the catalog is public without it.
# POKEMONTCG_API_KEY=<pokemontcg.io api key>

# Refuse every outbound provider call and read the vendored snapshot instead.
# This is what makes CI deterministic. Never set it in a deployment.
# SETVALUE_PROVIDER_OFFLINE=1

# ------------------------------------------------------------------ jobs -----
# SERVER ONLY. Shared secret the scheduled jobs present to the sync endpoints.
# Generate with `openssl rand -hex 32`. Must match the value stored in Supabase
# Vault as `setvalue_cron_secret`.
# SETVALUE_CRON_SECRET=<random 32-byte hex>

# --------------------------------------------------------------- billing -----
# Billing is off. It stays off unless all three of these are present, and no
# payment UI is reachable while it is off.
# SETVALUE_BILLING_ENABLED=false
# STRIPE_SECRET_KEY=
# STRIPE_WEBHOOK_SECRET=

# ------------------------------------------- local development identity ------
# The stand-in identity provider used only when no Supabase project is
# configured. It refuses to activate whenever NEXT_PUBLIC_SUPABASE_URL is set,
# and refuses to activate under NODE_ENV=production unless explicitly allowed.
# A deployment must set NEITHER of these.
# SETVALUE_ALLOW_LOCAL_AUTH=yes
# SETVALUE_LOCAL_AUTH_SECRET=<random string, development only>
